  classDef queue fill:#ffedd5,stroke:#ea580c,color:#7c2d12
  classDef external fill:#f1f5f9,stroke:#64748b,color:#1e293b,stroke-dasharray:4 3
  classDef security fill:#ffe4e6,stroke:#e11d48,color:#881337
